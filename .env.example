# Production domain — used for canonical URLs, sitemap, structured data and llms.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Strapi (optional — if unset or unreachable the site uses src/content/data/*.json)
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=

# Shared secret for the Strapi publish webhook -> POST /api/revalidate
REVALIDATE_SECRET=
